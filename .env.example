# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres connection string (Supabase -> Project Settings -> Database -> Connection pooling / Transaction)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ---------- AI ----------
ANTHROPIC_API_KEY=sk-ant-...
# Claude model used for structured extraction of voice logs (default: claude-opus-5)
CLAUDE_MODEL=claude-opus-5
OPENAI_API_KEY=sk-...
# Whisper model: whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
WHISPER_MODEL=whisper-1

# ---------- Security ----------
# 32 random bytes, base64 (generate: openssl rand -base64 32). Used for AES-256-GCM vault encryption.
VAULT_ENCRYPTION_KEY=
# Secret used to sign public approval links
APPROVAL_LINK_SECRET=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
COMPANY_NAME=Rich IT Solutions
COMPANY_PHONE=+972-50-000-0000
COMPANY_EMAIL=info@rich-it.co.il
COMPANY_ADDRESS=Israel
COMPANY_VAT_ID=000000000
COMPANY_WEBSITE=
ENGINEER_NAME=
DEFAULT_VAT_RATE=0.18

# ---------- Push notifications (optional) ----------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@rich-it.co.il

# ---------- Google Calendar ----------
# Not needed: the app exposes a signed, read-only ICS feed instead
# (Settings -> ICS feed link) that Google Calendar can subscribe to directly,
# without OAuth or a service account.
